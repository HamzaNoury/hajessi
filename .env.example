# HAJESSI — Configuration
# Copiez ce fichier vers .env.local et remplissez les valeurs

# Mot de passe admin (dashboard /admin/login)
ADMIN_PASSWORD=changez-moi-en-production

# URL Google Apps Script Web App (voir docs/SETUP.md)
GOOGLE_SHEET_WEBAPP_URL=https://script.google.com/macros/s/VOTRE_DEPLOYMENT_ID/exec

# Facebook Pixel — remplacer FB_PIXEL_ID par votre vrai ID
NEXT_PUBLIC_FB_PIXEL_ID=FB_PIXEL_ID

# Google Analytics 4 — remplacer GA_MEASUREMENT_ID par votre vrai ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=GA_MEASUREMENT_ID
